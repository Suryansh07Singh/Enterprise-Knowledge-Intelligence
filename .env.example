# Environment
ENV=development
DEBUG=true

# Security
SECRET_KEY=super-secret-enterprise-rag-key-change-in-production-2026

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:////app/data/enterprise_rag.db
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=enterprise_knowledge_chunks

# LLM Providers
PRIMARY_LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FALLBACK_LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings & Reranking
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hyperparameters
DENSE_TOP_K=25
SPARSE_TOP_K=25
RRF_K=60
RERANK_TOP_K=5
ABSTENTION_THRESHOLD=0.25
